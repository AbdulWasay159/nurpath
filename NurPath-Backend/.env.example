PORT=5000
MONGO_URI=your_mongodb_connection
# For local testing without a real database, use: MONGO_URI=memory
# (spins up a throwaway in-memory MongoDB; data is lost when the server stops)
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# ── Password reset emails (Resend — https://resend.com) ──
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=NurPath <onboarding@resend.dev>
